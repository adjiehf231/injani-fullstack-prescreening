# Python Backend Environment Configuration
ENVIRONMENT=development
PORT=8000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://user:password@localhost:5432/injani_db

# Security & Authentication (Replace with secure random secrets in production)
JWT_SECRET=change-me-to-a-secure-random-secret-key-at-least-32-chars
WEBHOOK_SECRET=change-me-to-a-secure-random-webhook-secret

# Self-hosted LLM Inference Endpoint (Ollama / vLLM)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=gemma3:4b
